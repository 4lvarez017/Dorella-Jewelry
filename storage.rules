rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Regla auxiliar: usuario autenticado (administrador)
    function isAdmin() {
      return request.auth != null;
    }

    // Imágenes de productos: lectura pública permanente; subida y modificación solo por admin con validación de imagen y peso (< 5MB)
    match /products/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin()
                   && (request.resource == null
                       || (request.resource.size < 5 * 1024 * 1024
                           && request.resource.contentType.matches('image/.*')));
    }
  }
}

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Regla auxiliar: usuario autenticado (administrador)
    function isAdmin() {
      return request.auth != null;
    }

    // Colección: products
    // Lectura pública para catálogo; escritura solo por admin
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Colección: orders
    // Creación pública desde checkout; lectura, actualización y borrado solo por admin
    match /orders/{orderId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // Colección: reviews
    // Lectura pública; creación pública con validación; eliminación solo por admin
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if request.resource.data.name is string 
                    && request.resource.data.comment is string
                    && request.resource.data.rating is number;
      allow update, delete: if isAdmin();
    }
  }
}

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Catálogo de productos: lectura pública y sincronización/gestión permitida
    match /products/{productId} {
      allow read: if true;
      allow write: if true;
    }

    // 2. Pedidos: cualquier cliente puede crear su pedido desde el checkout; 
    // lectura y gestión completa permitida
    match /orders/{orderId} {
      allow create, read, update, delete: if true;
    }

    // 3. Reseñas: lectura pública y publicación con validación básica de texto
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if request.resource.data.name is string 
                    && request.resource.data.comment is string;
      allow update, delete: if true;
    }
  }
}
